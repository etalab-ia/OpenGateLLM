---
import { TabItemTagname } from './rehype-tabs-custom';

interface Props {
	icon?: string;
	label: string;
}

const { icon, label } = Astro.props;

if (!label) {
	throw new Error('Missing prop `label` on `<TabItemCustom>` component.');
}
---

<TabItemTagname data-label={label} data-icon={icon}>
	<slot />
</TabItemTagname>
